rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection validation document
    match /test/connection {
      allow read: if true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMarketItem(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.price is number && data.price >= 0 && data.price <= 50000000 &&
        data.stock is number && data.stock >= 0 && data.stock <= 100000 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
        (!('originalPrice' in data) || (data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 50000000)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000000)) &&
        (!('condition' in data) || (data.condition is string && data.condition.size() <= 500)) &&
        (!('usedPeriod' in data) || (data.usedPeriod is string && data.usedPeriod.size() <= 200)) &&
        (!('size' in data) || (data.size is string && data.size() <= 200)) &&
        (!('components' in data) || (data.components is string && data.components.size() <= 500)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('locationTag' in data) || (data.locationTag is string && data.locationTag.size() <= 200)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Flea market items collection
    match /items/{itemId} {
      allow read: if true;
      allow create: if isValidId(itemId) && isValidMarketItem(incoming());
      allow update: if isValidId(itemId) && isValidMarketItem(incoming());
      allow delete: if isValidId(itemId);
    }
  }
}
